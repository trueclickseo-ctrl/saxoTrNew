# Avanza credentials — copy this to .env.avanza and fill in real values.
# .env.avanza is gitignored and never committed.

AVANZA_USERNAME=your_username_or_personal_number
AVANZA_PASSWORD=your_password
AVANZA_TOTP_SECRET=YOUR_BASE32_TOTP_SECRET_FROM_GOOGLE_AUTHENTICATOR

# Optional: hard-code your ISK account ID (found on first run with --info)
# If left blank, the script picks the first ISK account automatically.
AVANZA_ACCOUNT_ID=

# Approximate SEK/USD rate used for sizing US stocks (updated manually).
# Example: 10.5 means 1 USD = 10.5 SEK
AVANZA_SEK_USD_RATE=10.5

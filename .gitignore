# Secrets — NEVER commit these
# (comments must be on their own line; a trailing '#' is treated as
#  literal pattern text by git, which silently breaks the ignore rule)
saxo_token.json
saxo_token_live.json
.env
*.env
.env.binance
.env.live
# FTP credentials for the (legacy) dashboard upload
config/deploy.json
# Email credentials (Gmail app password) — copy email.json.template -> email.json to enable
config/email.json
# Binance — the .env.binance file holds testnet API keys
# (already caught by *.env above, but listed explicitly for clarity)

# ── Runtime state / databases — local only, not history ──────────
# SQLite databases (large, machine-local)
data/atos.db
data/atos_live.db
data/atos_live.db-shm
data/atos_live.db-wal
# Log files
data/monitor_log.txt
data/*.log
data/engine_*.log
# risk / daily capital trackers (regenerate automatically)
data/atos_risk_state.json
data/daily_state.json
data/risk_capital.json
data/us_momentum_state.json
data/atos_scan_state.json
# Binance equity stop state (peak equity + halt status; machine-local, gitignored)
data/binance_equity_state.json
# strategy monitor state
data/strategy_monitor.json
# gap strategy cooldown — per-week, per-pair re-entry block (runtime state, machine-local)
data/gap_cooldown.json
# Real-money LIVE forex account runtime state (positions/orders/peak-equity) --
# machine-local, never source-controlled, same as the other risk/state trackers above
data/forex_live_state.json
data/forex_live_orders.json
data/forex_live_peak_equity.json
# Cross-process lock files -- runtime-only, never meaningful across machines
*.lock
# generated HTML dashboard (was uploaded to namazic.com)
dashboard/

# Python
__pycache__/
*.pyc
*.pyo
atos/__pycache__/

# Regenerable data — large historical price CSVs, re-downloadable via data_loader.py
data/*.csv
!data/instrument_map.csv
!data/index_map.csv

# Runtime
results/
STOP_TRADING

# Virtual environment
.venv/
venv/

# Log files — never commit; large and machine-local
logs/

# Kill-switch sentinel files (written at runtime, not source-controlled)
STOP_BINANCE

# Backtest cache pickles (re-downloadable via --reset)
data/*.pkl

# Daily strategy charts — regenerated every day via daily_chart.py, machine-local
data/charts/

# CNN-LSTM model artifacts (large, regenerated via --train)
data/cnn_lstm/model.pt
data/cnn_lstm/scaler.json
data/cnn_lstm/report.json
data/cnn_lstm/config.json

# OS clutter
.DS_Store
Thumbs.db
.devtools/

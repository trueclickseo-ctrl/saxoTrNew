# IBKR stocks sleeve environment variables
# Copy to .env.ibkr and fill in your values.
# .env.ibkr is gitignored — never commit it.

# Account ID shown in IB Gateway / TWS (e.g. U1234567 for live, DU1234567 for paper)
IBKR_ACCOUNT_ID=DU1234567

# Set to 1 for paper trading (default), 0 for live
# Also controlled by --paper / --live flags in run_ibkr_stocks.py
IBKR_PAPER=1
